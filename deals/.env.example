# Every key is optional. Without any, the app still searches Slickdeals and
# Reddit (community deals + owner reviews). Each key you add turns on a source.

# Google Shopping organic results via SerpApi — covers Amazon, Walmart, Target,
# Costco, Newegg, B&H and hundreds more stores. https://serpapi.com
SERPAPI_KEY=

# Best Buy Products API (free). https://developer.bestbuy.com
BESTBUY_API_KEY=

# eBay Browse API (free). https://developer.ebay.com
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# YouTube Data API v3 for review videos (free). https://console.cloud.google.com
YOUTUBE_API_KEY=

# Optional Reddit app credentials for higher rate limits. https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# REDDIT_DEAL_SUBS=deals+buildapcsales+BlackFridayDeals+GameDeals

# Searches per minute per visitor (0 disables).
# RATE_LIMIT_PER_MIN=20

# Keepa API for years of Amazon price history (paid). https://keepa.com/#!api
KEEPA_API_KEY=

# Where Deal Desk stores its own cross-store price history. Point this at a
# persistent disk/volume in production or the history resets on redeploy.
# DATA_DIR=./data

# Re-check recently searched products every N hours so the tracker records a
# price every day, not only on days someone searches. Each refresh spends API
# calls (up to TRACK_REFRESH_LIMIT products). 0 = off.
# TRACK_REFRESH_HOURS=12
# TRACK_REFRESH_LIMIT=50
